Q3_p2 <- ggplot(bp) + geom_histogram(aes(x=value, fill=gene), alpha=0.5, bins= 100)
Q3_p3 <- ggplot(bp) + geom_density(aes(x=value, col=gene), alpha=0.2) + theme(legend.position="none")
((Q3_p1 + Q3_p3) / Q3_p2) + plot_layout(guides = "collect") +
plot_annotation(
title = "Comparative summary statistics",
subtitle = "for contaminated gene sample data")
a <- as.data.frame(which(woops$gene1 > mean(woops$gene1) + 3 * sd(woops$gene1), arr.ind = TRUE)) %>% rename(gene1 = 1) %>% mutate(id = row_number())
b <- as.data.frame(which(woops$gene2 > mean(woops$gene2) + 3 * sd(woops$gene2), arr.ind = TRUE)) %>% rename(gene2 = 1) %>% mutate(id = row_number())
c <- as.data.frame(which(woops$gene3 > mean(woops$gene3) + 3 * sd(woops$gene3), arr.ind = TRUE)) %>% rename(gene3 = 1) %>% mutate(id = row_number())
d <- full_join(a, b, by ='id')
e <- full_join(d, c, by = "id")
e %>% select (-id) %>% gt() %>%
tab_header(
title = "Outlier row numbers by gene",
subtitle = "greater than 3 standard deviations from mean"
)
#set up models to compare
lm1_2 <- lm(gene1 ~ gene2, woops)
lm1_3 <- lm(gene1 ~ gene3, woops)
lm2_3 <- lm(gene2 ~ gene3, woops)
lm1_2_3 <- lm(gene1 ~ gene2 + gene3, woops)
#functions
diagnostic_plots <- function (model, title = "") {
diag <- autoplot(model, which = 1:4, ncol = 2, label.size = 3) + theme(plot.title = element_text(size = 10))
grid.arrange(grobs = diag@plots, top = paste("Regression diagnostic plots ", title))
}
#--------------------------------------------------------------------------------------------------------------------------------------------------
regression_analysis <- function(id, gene, model, title = "" ) {
plot_data <- data.frame(id = id, Predicted_value = predict(model), Observed_value = gene, residuals = residuals(model))
highlight <- which(plot_data$residuals > mean(plot_data$residuals) + 3 * sd(plot_data$residuals), arr.ind = TRUE)
hl_data <- plot_data[highlight, ]
ggplot(plot_data, aes(x = Predicted_value, y = Observed_value)) +
geom_point() +
geom_point(data=hl_data, colour="red") +
geom_abline(intercept = 0, slope = 1, color = "red") +
geom_text(data=hl_data, aes(label = id), size = 4, vjust=-0.5) +
labs(title = paste(title, " model regression analysis"), subtitle = "Predicted values on observed values", x = "Predicted values", y = "Observed value") + theme_minimal()
}
diagnostic_plots(lm1_2, "gene 2 on gene 1")
