library(rules)
library(recipes)
library(finetune)
library(workflowsets)
library(earth)
library(kknn)
library(kernlab)
library(xgboost)
library(doParallel)
library(future)
library(corrplot)
plan(multisession, workers = 4)
ice.train <- read_csv("https://www.massey.ac.nz/~jcmarsha/161324/assessment/data/ice-train.csv")
ice.test  <- read_csv("https://www.massey.ac.nz/~jcmarsha/161324/assessment/data/ice-test.csv")
#convert lat/lon to radians on a continuous scale and make year is a factor
radians <- function(x) {return(x * pi/180)}
ice.train <- ice.train %>% mutate(MinLonRad = radians(MinLon), MinLatRad = radians(MinLat), MaxLonRad = radians(MaxLon), MaxLatRad = radians(MaxLat), YearFactor = as.factor(Year)) %>% select(Thickness, Year, YearFactor, everything())
ice.test <- ice.test %>% mutate(MinLonRad = radians(MinLon), MinLatRad = radians(MinLat), MaxLonRad = radians(MaxLon), MaxLatRad = radians(MaxLat), YearFactor = as.factor(Year)) %>% select(Year, YearFactor, everything())
corrplot(cor(ice.train), method='number',  type = "lower", order = "AOE", diag = FALSE)
corrplot(cor(ice.train), method='number',  type = "lower", order = "AOE", diag = FALSE)
ice.train <- ice.train %>% mutate(MinLonRad = radians(MinLon), MinLatRad = radians(MinLat), MaxLonRad = radians(MaxLon), MaxLatRad = radians(MaxLat), YearFactor = as.factor(Year)) %>% select(Thickness, Year, YearFactor, everything())
ice.test <- ice.test %>% mutate(MinLonRad = radians(MinLon), MinLatRad = radians(MinLat), MaxLonRad = radians(MaxLon), MaxLatRad = radians(MaxLat), YearFactor = as.factor(Year)) %>% select(Year, YearFactor, everything())
corrplot(cor(ice.train), method='number',  type = "lower", order = "AOE", diag = FALSE)
ice.train
ice.train
ice.train
